# Content source. `{lang}` is replaced with `en` or `ar`.
# Default (when unset): static JSON edited in /content/site.{lang}.json
NUXT_PUBLIC_CONTENT_URL=/data/content.{lang}.json
# Later, point it at the dashboard API instead:
# NUXT_PUBLIC_CONTENT_URL=https://api.drixal.com/website/content?lang={lang}

# Contact form POST endpoint (JSON). Leave empty to fall back to opening the visitor's email app.
NUXT_PUBLIC_CONTACT_ENDPOINT=
NUXT_PUBLIC_CONTACT_EMAIL=info@drixal.com

# Spline.design hero scene (.splinecode URL from Export → Code → Vanilla JS).
# Leave empty to use the CSS glass-card 3D fallback only.
# Optional in the scene: Number variable named `scroll` (0–1) driven by hero scroll.
# Leave empty to use the built-in Earth hero scene.
# NUXT_PUBLIC_SPLINE_SCENE=https://prod.spline.design/YOUR-ID/scene.splinecode
